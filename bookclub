#!/bin/zsh

# Plattformsdetektering
detect_platform() {
    if [[ $(uname -m) == "arm"* ]] || [[ $(uname -m) == "aarch"* ]]; then
        echo "raspberry"
    elif [[ -f /etc/volumio_version ]]; then
        echo "volumio"
    elif [[ -f /etc/fedora-release ]]; then
        echo "fedora"
    else
        echo "unknown"
    fi
}

PLATFORM=$(detect_platform)

usage() {
    echo "Användning: $0 [-sync | -chat | -dev | -setup]"
    echo "  -sync   Hämtar data från Goodreads och uppdaterar läslistan automatiskt"
    echo "  -chat   Startar AI-chatt om dina böcker"
    echo "  -dev    Startar i utvecklingsläge med DeepSeek"
    echo "  -setup  Installerar nödvändiga beroenden för $PLATFORM"
    exit 1
}

# Ladda miljövariabler från .env om filen finns
if [[ -f ".env" ]]; then
    source .env
elif [[ -f ".env.local" ]]; then
    source .env.local
fi

# Kontrollera att API-nyckeln är satt i synk-läge
check_api_key() {
    if [[ -z "$GOODREADS_API_KEY" ]]; then
        echo "❌ Fel: GOODREADS_API_KEY är inte satt."
        echo "   Skapa en .env-fil med: GOODREADS_API_KEY='din_nyckel_here'"
        exit 1
    fi
}

if [[ $# -eq 0 ]]; then
    usage
fi

LOG_FILE="reading_log.md"

case "$1" in
    -sync)
        echo "🚀 Startar synkronisering..."
        check_api_key
        
        # 1. Hämta data
        echo "📥 Hämtar data från Goodreads..."
        curl -s "https://www.goodreads.com/review/list_rss/137796233?key=${GOODREADS_API_KEY}&shelf=read" > raw_books.xml
        
        if [[ $? -ne 0 ]]; then
            echo "❌ Fel vid hämtning av data från Goodreads."
            exit 1
        fi

        # 2. Bearbeta data med Python-scriptet
        echo "⚙️ Bearbetar data med sync_books.py..."
        python3 sync_books.py
        
        if [[ $? -ne 0 ]]; then
            echo "❌ Fel vid bearbetning av data."
            exit 1
        fi

        echo "✅ Synkronisering klar."
        ;;
    -chat)
        echo "💬 Startar boksamtal (Modell: Grok 4.1 Fast)..."
        # Kontrollera om loggfilen finns innan vi försöker läsa den
        if [[ -f "$LOG_FILE" ]]; then
            aider --no-gitignore --config .aider.chat.yml --read "$LOG_FILE"
        else
            echo "⚠️ Varning: Ingen loggfil hittades ($LOG_FILE). Startar Aider utan läslogg."
            aider --no-gitignore --config .aider.chat.yml
        fi
        ;;
    -setup)
        echo "🔧 Installerar beroenden för $PLATFORM..."
        
        case $PLATFORM in
            raspberry|volumio)
                # Raspberry Pi / Volumio (Debian-baserat)
                echo "📦 Installerar paket med apt..."
                sudo apt update
                sudo apt install -y python3 python3-pip curl git
                pip3 install --user aider-chat
                ;;
            fedora)
                # Fedora (PC)
                echo "📦 Installerar paket med dnf..."
                sudo dnf install -y python3 python3-pip curl git
                pip3 install --user aider-chat
                ;;
            *)
                echo "⚠️ Okänd plattform. Installera manuellt:"
                echo "   Python3, pip, curl, git, och 'pip install aider-chat'"
                ;;
        esac
        
        echo "✅ Installation klar! Kör nu:"
        echo "   ./bookclub -sync   # Första synk"
        echo "   ./bookclub -chat   # Starta chatt"
        ;;
    -dev)
        echo "🔧 Startar i utvecklingsläge (Modell: Qwen3 Coder Next)..."
        check_api_key
        aider --no-gitignore --config .aider.dev.yml
        ;;
    *)
        usage
        ;;
esac
