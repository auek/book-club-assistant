#!/bin/zsh

# Platform detection
detect_platform() {
    if [[ $(uname -m) == "arm"* ]] || [[ $(uname -m) == "aarch"* ]]; then
        echo "raspberry"
    elif [[ -f /etc/volumio_version ]]; then
        echo "volumio"
    elif [[ -f /etc/fedora-release ]]; then
        echo "fedora"
    else
        echo "unknown"
    fi
}

PLATFORM=$(detect_platform)

usage() {
    echo "Usage: $0 [-sync | -chat | -dev | -setup]"
    echo "  -sync   Fetches data from Goodreads and updates reading list automatically"
    echo "  -chat   Starts AI chat about your books"
    echo "  -dev    Starts development mode with DeepSeek"
    echo "  -setup  Installs necessary dependencies for $PLATFORM"
    echo ""
    echo "For Raspberry Pi, use bookclub.pi instead:"
    echo "  ./bookclub.pi [-sync | -setup | -bot | -cron]"
    exit 1
}

# Load environment variables from .env if file exists
if [[ -f ".env" ]]; then
    source .env
elif [[ -f ".env.local" ]]; then
    source .env.local
fi

# Check that API key and user ID are set for sync mode
check_api_key() {
    if [[ -z "$GOODREADS_API_KEY" ]]; then
        echo "❌ Error: GOODREADS_API_KEY is not set."
        echo "   Create a .env file with: GOODREADS_API_KEY='your_key_here'"
        exit 1
    fi
    if [[ -z "$GOODREADS_USER_ID" ]]; then
        echo "❌ Error: GOODREADS_USER_ID is not set."
        echo "   Add GOODREADS_USER_ID='your_user_id_here' to your .env file"
        echo "   Find your ID at: https://www.goodreads.com/settings"
        exit 1
    fi
}

if [[ $# -eq 0 ]]; then
    usage
fi

case "$1" in
    -sync)
        echo "🚀 Starting synchronization..."
        check_api_key
        
        # 1. Fetch data
        echo "📥 Fetching data from Goodreads (User ID: ${GOODREADS_USER_ID})..."
        curl -s "https://www.goodreads.com/review/list_rss/${GOODREADS_USER_ID}?key=${GOODREADS_API_KEY}&shelf=read" > raw_books.xml
        
        if [[ $? -ne 0 ]]; then
            echo "❌ Error while fetching data from Goodreads."
            exit 1
        fi

        # 2. Process data with Python script
        echo "⚙️ Processing data with sync_books.py..."
        python3 sync_books.py
        
        if [[ $? -ne 0 ]]; then
            echo "❌ Error while processing data."
            exit 1
        fi

        echo "✅ Synchronization complete."
        ;;
    -chat)
        echo "💬 Starting book chat (Model: Grok 4.1 Fast)..."
        
        # Create reading_log.md if it doesn't exist
        if [[ ! -f "reading_log.md" ]]; then
            echo "📄 Creating empty reading_log.md file..."
            echo "# Lästa Böcker" > reading_log.md
            echo "" >> reading_log.md
            echo "Inga böcker synkade än. Kör './bookclub -sync' för att synkronisera från Goodreads." >> reading_log.md
        fi
        
        # Create reading_in_progress.md if it doesn't exist
        if [[ ! -f "reading_in_progress.md" ]]; then
            echo "📄 Creating reading_in_progress.md with helpful template..."
            cat > reading_in_progress.md << 'EOF'
# Pågående Läsning

## 📖 Just nu

### 1. **Sapiens: en kort historik över mänskligheten** av Yuval Noah Harari - (Progress: 45%)
   - Anteckningar: Intressant perspektiv på människans utveckling och hur samhällen har formats.

### 2. **Mina drömmars stad** av Jonas Gardell - (Progress: 80%)
   - Anteckningar: Stark och känsloladdad berättelse om att hitta sin plats i världen.

## 💭 Kommande böcker

- **Alkemisten** av Paulo Coelho
- **1984** av George Orwell
- **Mörkrets hjärta** av Joseph Conrad

## 📚 Läses av andra (Rekommendationer)

- **Normal People** av Sally Rooney - Rekommenderad av Anna
- **Klara and the Sun** av Kazuo Ishiguro - Rekommenderad av David

## 📝 Noteringar

- Läsa minst 30 minuter per dag
- Kom ihåg att skriva ner tankar direkt när jag läser
- Diskutera böckerna med bokklubben på torsdag

---
*Denna fil kan redigeras via AI-chatten med kommandot `./bookclub -chat`*
EOF
        fi
        
        # Start the chat
        aider --no-gitignore --config .aider.chat.yml 
        ;;
    -setup)
        echo "🔧 Installing dependencies for $PLATFORM..."
        
        case $PLATFORM in
            fedora)
                # Fedora (PC)
                echo "📦 Installing packages with dnf..."
                sudo dnf install -y python3 python3-pip curl git
                pip3 install --user aider-chat
                ;;
            *)
                echo "⚠️ Unknown platform. Please install manually:"
                echo "   Python3, pip, curl, git, and 'pip install aider-chat'"
                ;;
        esac
        
        echo "✅ Installation complete! Now run:"
        echo "   ./bookclub -sync   # First sync"
        echo "   ./bookclub -chat   # Start chat"
        ;;
    -dev)
        echo "🔧 Starting development mode (Model: Qwen3 Coder Next)..."
        check_api_key
        aider --no-gitignore --config .aider.dev.yml
        ;;
    *)
        usage
        ;;
esac
