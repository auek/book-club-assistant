#!/bin/zsh

usage() {
    echo "Användning: $0 [-sync | -chat]"
    echo "  -sync   Startar Aider med DeepSeek för att uppdatera läslistan (redigering aktiverad)"
    echo "  -chat   Startar Aider med Grok för att diskutera böcker (läsläge aktiverat)"
    echo "  -dev   Startar Aider i utvecklingsläge med DeepSeek (för testning och felsökning)"
    exit 1
}

# Ladda miljövariabler från .env om filen finns
if [[ -f ".env" ]]; then
    source .env
elif [[ -f ".env.local" ]]; then
    source .env.local
fi

# Kontrollera att API-nyckeln är satt i synk-läge
check_api_key() {
    if [[ -z "$GOODREADS_API_KEY" ]]; then
        echo "❌ Fel: GOODREADS_API_KEY är inte satt."
        echo "   Skapa en .env-fil med: GOODREADS_API_KEY='din_nyckel_here'"
        exit 1
    fi
}

if [[ $# -eq 0 ]]; then
    usage
fi

LOG_FILES=(reading_log_*.md(N))
#RAW_DATA=(raw_books.xml(N))

case "$1" in
    -sync)
        echo "🚀 Startar synkronisering (Modell: DeepSeek V3.2)..."
        check_api_key
        aider --no-gitignore --config .aider.sync.yml --file "${LOG_FILES[@]}" 
        ;;
    -chat)
        echo "💬 Startar boksamtal (Modell: Grok 4.1 Fast)..."
        aider --no-gitignore --config .aider.chat.yml --read "${LOG_FILES[@]}"
        ;;
    -dev)
        echo "🔧 Startar i utvecklingsläge (Modell: DeepSeek V3.2)..."
        check_api_key
        aider --no-gitignore --config .aider.dev.yml --file "${LOG_FILES[@]}"
        ;;
    *)
        usage
        ;;
esac
