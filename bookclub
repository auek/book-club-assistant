#!/bin/zsh

usage() {
    echo "Användning: $0 [-sync | -chat]"
    echo "  -sync   Startar Aider med DeepSeek för att uppdatera läslistan (redigering aktiverad)"
    echo "  -chat   Startar Aider med Grok för att diskutera böcker (läsläge aktiverat)"
    exit 1
}

if [[ $# -eq 0 ]]; then
    usage
fi

LOG_FILES=(reading_log_*.md(N))
#RAW_DATA=(raw_books.xml(N))

case "$1" in
    -sync)
        echo "🚀 Startar synkronisering (Modell: DeepSeek V3.2)..."
        aider --config .aider.sync.yml --file "${LOG_FILES[@]}" 
        ;;
    -chat)
        echo "💬 Startar boksamtal (Modell: Grok 4.1 Fast)..."
        aider --config .aider.chat.yml --read "${LOG_FILES[@]}"
        ;;
    *)
        usage
        ;;
esac
